test "standard oracle sdivo width 3" {
  let rows = [
    (0UL, 0UL, 0UL),
    (0UL, 1UL, 0UL),
    (0UL, 2UL, 0UL),
    (0UL, 3UL, 0UL),
    (0UL, 4UL, 0UL),
    (0UL, 5UL, 0UL),
    (0UL, 6UL, 0UL),
    (0UL, 7UL, 0UL),
    (1UL, 0UL, 0UL),
    (1UL, 1UL, 0UL),
    (1UL, 2UL, 0UL),
    (1UL, 3UL, 0UL),
    (1UL, 4UL, 0UL),
    (1UL, 5UL, 0UL),
    (1UL, 6UL, 0UL),
    (1UL, 7UL, 0UL),
    (2UL, 0UL, 0UL),
    (2UL, 1UL, 0UL),
    (2UL, 2UL, 0UL),
    (2UL, 3UL, 0UL),
    (2UL, 4UL, 0UL),
    (2UL, 5UL, 0UL),
    (2UL, 6UL, 0UL),
    (2UL, 7UL, 0UL),
    (3UL, 0UL, 0UL),
    (3UL, 1UL, 0UL),
    (3UL, 2UL, 0UL),
    (3UL, 3UL, 0UL),
    (3UL, 4UL, 0UL),
    (3UL, 5UL, 0UL),
    (3UL, 6UL, 0UL),
    (3UL, 7UL, 0UL),
    (4UL, 0UL, 0UL),
    (4UL, 1UL, 0UL),
    (4UL, 2UL, 0UL),
    (4UL, 3UL, 0UL),
    (4UL, 4UL, 0UL),
    (4UL, 5UL, 0UL),
    (4UL, 6UL, 0UL),
    (4UL, 7UL, 1UL),
    (5UL, 0UL, 0UL),
    (5UL, 1UL, 0UL),
    (5UL, 2UL, 0UL),
    (5UL, 3UL, 0UL),
    (5UL, 4UL, 0UL),
    (5UL, 5UL, 0UL),
    (5UL, 6UL, 0UL),
    (5UL, 7UL, 0UL),
    (6UL, 0UL, 0UL),
    (6UL, 1UL, 0UL),
    (6UL, 2UL, 0UL),
    (6UL, 3UL, 0UL),
    (6UL, 4UL, 0UL),
    (6UL, 5UL, 0UL),
    (6UL, 6UL, 0UL),
    (6UL, 7UL, 0UL),
    (7UL, 0UL, 0UL),
    (7UL, 1UL, 0UL),
    (7UL, 2UL, 0UL),
    (7UL, 3UL, 0UL),
    (7UL, 4UL, 0UL),
    (7UL, 5UL, 0UL),
    (7UL, 6UL, 0UL),
    (7UL, 7UL, 0UL),
  ]
  for (a, b, expected) in rows {
    let source = "1 sort bitvec 3\n2 sort bitvec 1\n3 input 1 a\n4 input 1 b\n5 sdivo 2 3 4\n6 output 5\n7 constd 2 \{expected}\n8 eq 2 5 7\n9 bad 8\n10 constd 1 \{a}\n11 eq 2 3 10\n12 constraint 11\n13 constd 1 \{b}\n14 eq 2 4 13\n15 constraint 14"
    let model = @moonbtor.parse(source).unwrap()
    assert_eq(model.observe({ state: [], inputs: [a, b], }).unwrap().outputs, [
      expected,
    ])

    if 3 <= 3 {
      let q = model.query(0).unwrap()
      match q.formula().solve() {
        Satisfiable(bits) => ignore(q.decode_typed(bits).unwrap())
        _ => fail("expected satisfiable oracle")
      }
      let wrong = @moonbtor.parse(source.replace_all(old="8 eq", new="8 neq")).unwrap()
      assert_true(wrong.query(0).unwrap().formula().solve() is Unsatisfiable)
    }
  }
}

///|
test "standard oracle sdivo width 32" {
  let rows = [
    (0UL, 0UL, 0UL),
    (0UL, 1UL, 0UL),
    (0UL, 2147483647UL, 0UL),
    (0UL, 2147483648UL, 0UL),
    (0UL, 4294967295UL, 0UL),
    (1UL, 0UL, 0UL),
    (1UL, 1UL, 0UL),
    (1UL, 2147483647UL, 0UL),
    (1UL, 2147483648UL, 0UL),
    (1UL, 4294967295UL, 0UL),
    (2147483647UL, 0UL, 0UL),
    (2147483647UL, 1UL, 0UL),
    (2147483647UL, 2147483647UL, 0UL),
    (2147483647UL, 2147483648UL, 0UL),
    (2147483647UL, 4294967295UL, 0UL),
    (2147483648UL, 0UL, 0UL),
    (2147483648UL, 1UL, 0UL),
    (2147483648UL, 2147483647UL, 0UL),
    (2147483648UL, 2147483648UL, 0UL),
    (2147483648UL, 4294967295UL, 1UL),
    (4294967295UL, 0UL, 0UL),
    (4294967295UL, 1UL, 0UL),
    (4294967295UL, 2147483647UL, 0UL),
    (4294967295UL, 2147483648UL, 0UL),
    (4294967295UL, 4294967295UL, 0UL),
    (4128070069UL, 2727621283UL, 0UL),
    (1580368505UL, 4214293354UL, 0UL),
    (678746808UL, 1673706420UL, 0UL),
    (1070387337UL, 3321597089UL, 0UL),
    (387182010UL, 1428743635UL, 0UL),
    (925800576UL, 2776182931UL, 0UL),
    (826417831UL, 124594985UL, 0UL),
    (3534527816UL, 1051783972UL, 0UL),
  ]
  for (a, b, expected) in rows {
    let source = "1 sort bitvec 32\n2 sort bitvec 1\n3 input 1 a\n4 input 1 b\n5 sdivo 2 3 4\n6 output 5\n7 constd 2 \{expected}\n8 eq 2 5 7\n9 bad 8\n10 constd 1 \{a}\n11 eq 2 3 10\n12 constraint 11\n13 constd 1 \{b}\n14 eq 2 4 13\n15 constraint 14"
    let model = @moonbtor.parse(source).unwrap()
    assert_eq(model.observe({ state: [], inputs: [a, b], }).unwrap().outputs, [
      expected,
    ])

    if 32 <= 3 {
      let q = model.query(0).unwrap()
      match q.formula().solve() {
        Satisfiable(bits) => ignore(q.decode_typed(bits).unwrap())
        _ => fail("expected satisfiable oracle")
      }
      let wrong = @moonbtor.parse(source.replace_all(old="8 eq", new="8 neq")).unwrap()
      assert_true(wrong.query(0).unwrap().formula().solve() is Unsatisfiable)
    }
  }
}

