///|
test "Python oracle iff width1 concrete and symbolic" {
  let rows = [
    (0UL, 0UL, 1UL),
    (0UL, 1UL, 0UL),
    (1UL, 0UL, 0UL),
    (1UL, 1UL, 1UL),
  ]
  for (a, b, expected) in rows {
    let source = "1 sort bitvec 1\n2 sort bitvec 1\n3 input 1 a\n4 input 1 b\n5 iff 2 3 4\n6 output 5\n7 constd 2 \{expected}\n8 eq 2 5 7\n9 bad 8\n10 constd 1 \{a}\n11 eq 2 3 10\n12 constraint 11\n13 constd 1 \{b}\n14 eq 2 4 13\n15 constraint 14"
    let model = @moonbtor.parse(source).unwrap()
    assert_eq(model.observe({ state: [], inputs: [a, b], }).unwrap().outputs, [
      expected,
    ])
    assert_true(model.query(0).unwrap().formula().solve() is Satisfiable(_))
    let wrong = @moonbtor.parse(source.replace_all(old="8 eq", new="8 neq")).unwrap()
    assert_true(wrong.query(0).unwrap().formula().solve() is Unsatisfiable)
  }
}

///|
test "Python oracle implies width1 concrete and symbolic" {
  let rows = [
    (0UL, 0UL, 1UL),
    (0UL, 1UL, 1UL),
    (1UL, 0UL, 0UL),
    (1UL, 1UL, 1UL),
  ]
  for (a, b, expected) in rows {
    let source = "1 sort bitvec 1\n2 sort bitvec 1\n3 input 1 a\n4 input 1 b\n5 implies 2 3 4\n6 output 5\n7 constd 2 \{expected}\n8 eq 2 5 7\n9 bad 8\n10 constd 1 \{a}\n11 eq 2 3 10\n12 constraint 11\n13 constd 1 \{b}\n14 eq 2 4 13\n15 constraint 14"
    let model = @moonbtor.parse(source).unwrap()
    assert_eq(model.observe({ state: [], inputs: [a, b], }).unwrap().outputs, [
      expected,
    ])
    assert_true(model.query(0).unwrap().formula().solve() is Satisfiable(_))
    let wrong = @moonbtor.parse(source.replace_all(old="8 eq", new="8 neq")).unwrap()
    assert_true(wrong.query(0).unwrap().formula().solve() is Unsatisfiable)
  }
}
