///|
test "Python oracle sra width32 concrete and symbolic" {
  let rows = [
    (0UL, 0UL, 0UL),
    (0UL, 1UL, 0UL),
    (0UL, 31UL, 0UL),
    (0UL, 32UL, 0UL),
    (0UL, 2147483647UL, 0UL),
    (0UL, 2147483648UL, 0UL),
    (0UL, 4294967295UL, 0UL),
    (1UL, 0UL, 1UL),
    (1UL, 1UL, 0UL),
    (1UL, 31UL, 0UL),
    (1UL, 32UL, 0UL),
    (1UL, 2147483647UL, 0UL),
    (1UL, 2147483648UL, 0UL),
    (1UL, 4294967295UL, 0UL),
    (31UL, 0UL, 31UL),
    (31UL, 1UL, 15UL),
    (31UL, 31UL, 0UL),
    (31UL, 32UL, 0UL),
    (31UL, 2147483647UL, 0UL),
