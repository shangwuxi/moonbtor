    (3UL, 4UL, 0UL),
    (3UL, 5UL, 0UL),
    (3UL, 6UL, 0UL),
    (3UL, 7UL, 0UL),
    (4UL, 0UL, 4UL),
    (4UL, 1UL, 2UL),
    (4UL, 2UL, 1UL),
    (4UL, 3UL, 0UL),
    (4UL, 4UL, 0UL),
    (4UL, 5UL, 0UL),
    (4UL, 6UL, 0UL),
    (4UL, 7UL, 0UL),
    (5UL, 0UL, 5UL),
    (5UL, 1UL, 2UL),
    (5UL, 2UL, 1UL),
    (5UL, 3UL, 0UL),
    (5UL, 4UL, 0UL),
    (5UL, 5UL, 0UL),
    (5UL, 6UL, 0UL),
    (5UL, 7UL, 0UL),
    (6UL, 0UL, 6UL),
    (6UL, 1UL, 3UL),
    (6UL, 2UL, 1UL),
    (6UL, 3UL, 0UL),
    (6UL, 4UL, 0UL),
    (6UL, 5UL, 0UL),
    (6UL, 6UL, 0UL),
