}

///|
test "Python oracle srl width32 concrete and symbolic" {
  let rows = [
    (0UL, 0UL, 0UL),
    (0UL, 1UL, 0UL),
    (0UL, 31UL, 0UL),
    (0UL, 32UL, 0UL),
    (0UL, 2147483647UL, 0UL),
    (0UL, 2147483648UL, 0UL),
    (0UL, 4294967295UL, 0UL),
    (1UL, 0UL, 1UL),
    (1UL, 1UL, 0UL),
    (1UL, 31UL, 0UL),
    (1UL, 32UL, 0UL),
    (1UL, 2147483647UL, 0UL),
    (1UL, 2147483648UL, 0UL),
    (1UL, 4294967295UL, 0UL),
    (31UL, 0UL, 31UL),
    (31UL, 1UL, 15UL),
    (31UL, 31UL, 0UL),
    (31UL, 32UL, 0UL),
    (31UL, 2147483647UL, 0UL),
    (31UL, 2147483648UL, 0UL),
    (31UL, 4294967295UL, 0UL),
    (32UL, 0UL, 32UL),
    (32UL, 1UL, 16UL),
    (32UL, 31UL, 0UL),
    (32UL, 32UL, 0UL),
    (32UL, 2147483647UL, 0UL),
    (32UL, 2147483648UL, 0UL),
    (32UL, 4294967295UL, 0UL),
    (2147483647UL, 0UL, 2147483647UL),
    (2147483647UL, 1UL, 1073741823UL),
    (2147483647UL, 31UL, 0UL),
    (2147483647UL, 32UL, 0UL),
    (2147483647UL, 2147483647UL, 0UL),
    (2147483647UL, 2147483648UL, 0UL),
    (2147483647UL, 4294967295UL, 0UL),
    (2147483648UL, 0UL, 2147483648UL),
    (2147483648UL, 1UL, 1073741824UL),
    (2147483648UL, 31UL, 1UL),
    (2147483648UL, 32UL, 0UL),
    (2147483648UL, 2147483647UL, 0UL),
    (2147483648UL, 2147483648UL, 0UL),
    (2147483648UL, 4294967295UL, 0UL),
    (4294967295UL, 0UL, 4294967295UL),
    (4294967295UL, 1UL, 2147483647UL),
    (4294967295UL, 31UL, 1UL),
    (4294967295UL, 32UL, 0UL),
    (4294967295UL, 2147483647UL, 0UL),
    (4294967295UL, 2147483648UL, 0UL),
    (4294967295UL, 4294967295UL, 0UL),
  ]
  for (a, b, expected) in rows {
    let source = "1 sort bitvec 32\n2 sort bitvec 1\n3 input 1 a\n4 input 1 b\n5 srl 1 3 4\n6 output 5\n7 constd 1 \{expected}\n8 eq 2 5 7\n9 bad 8\n10 constd 1 \{a}\n11 eq 2 3 10\n12 constraint 11\n13 constd 1 \{b}\n14 eq 2 4 13\n15 constraint 14"
    let model = @moonbtor.parse(source).unwrap()
    assert_eq(model.observe({ state: [], inputs: [a, b], }).unwrap().outputs, [
      expected,
